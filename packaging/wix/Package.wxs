<?xml version="1.0" encoding="utf-8"?>
<!--
  ClipboardX 的 Windows 安装包定义（WiX v4+ 架构，版本由 .config/dotnet-tools.json 固定）。

  设计要点：
  - Scope="perUser"：剪贴板只能在用户交互会话中访问，因此不做 per-machine 安装、
    不注册 Windows 服务（Session 0 读不到剪贴板），安装过程不需要管理员权限。
  - 自启写 HKCU 下的 Run 键，指向 cx.exe 的 start 子命令（静默模式）；
    与 macOS LaunchAgent、Linux systemd user unit 语义一致。
  - 覆盖安装 / 卸载会先停掉正在运行的 cx（cx stop + taskkill 兜底），装完再
    cx start 放回后台：否则自启的守护进程正占着 cx.exe，MSI 会弹"文件正在使用"
    对话框等人点（看起来就是卡住），静默安装则直接 1603。见文件末尾的 CustomAction。
  - 卸载保留用户数据（%APPDATA%\ClipboardX），REMOVEUSERDATA=1 时才清除。

  构建：pwsh scripts/build-msi.ps1
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
      Name="ClipboardX"
      Manufacturer="ClipboardX contributors"
      Version="$(var.ProductVersion)"
      UpgradeCode="FEA68C3B-3B6D-4D3D-8E08-856BECAA6EAB"
      Scope="perUser"
      Compressed="yes"
      Codepage="936">

    <SummaryInformation
        Codepage="936"
        Description="ClipboardX —— 极度轻量的三端剪贴板同步（守护进程 + TUI）"
        Manufacturer="ClipboardX contributors" />

    <!-- 允许降级安装：nightly 的版本号是 0.1.<一年中的第几天>.<构建序号>，数字上大于
         正式版 0.1.0，若不允许降级，"装过 nightly 之后装正式版"会被直接拒绝
         （报"已安装更高版本"）。允许降级时 MSI 会先移除旧产品再装当前版本，
         对使用者来说就是"我要这个版本，装它"——比拒绝更符合预期。
         注意：AllowDowngrades="yes" 与 AllowSameVersionUpgrades、DowngradeErrorMessage
         互斥（WiX 会直接报错），它本身已涵盖"同版本重装"与"降级覆盖"两种情况。 -->
    <MajorUpgrade AllowDowngrades="yes" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="ARPHELPLINK" Value="https://github.com/quyansiyuanwang/ClipboardX" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <!-- 卸载时是否连同配置/密钥/历史一起清除 -->
    <Property Id="REMOVEUSERDATA" Secure="yes" />

    <!-- 安装位置：%LOCALAPPDATA%\Programs\ClipboardX（per-user，无需提权） -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="CxProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="ClipboardX" />
      </Directory>
    </StandardDirectory>

    <!-- 用户数据目录：%APPDATA%\ClipboardX -->
    <StandardDirectory Id="AppDataFolder">
      <Directory Id="CxUserDataFolder" Name="ClipboardX" />
    </StandardDirectory>

    <!-- 开始菜单 -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="CxMenuFolder" Name="ClipboardX" />
    </StandardDirectory>

    <Feature Id="Main" Title="ClipboardX 核心" Level="1" AllowAbsent="no"
             Description="守护进程与命令行（cx.exe）">
      <ComponentGroupRef Id="CxBinaries" />
      <ComponentRef Id="CxStartMenu" />
    </Feature>

    <Feature Id="PathEnv" Title="加入 PATH" Level="1" AllowAbsent="yes"
             Description="把安装目录加入当前用户的 PATH，之后可直接运行 cx">
      <ComponentRef Id="CxUserPath" />
    </Feature>

    <Feature Id="Autostart" Title="登录后自动后台运行" Level="1" AllowAbsent="yes"
             Description="登录时自动启动剪贴板同步守护进程（HKCU Run）">
      <ComponentRef Id="CxAutostart" />
    </Feature>

    <Feature Id="DesktopShortcut" Title="桌面快捷方式（TUI）" Level="1000" AllowAbsent="yes"
             Description="在桌面创建打开终端界面的快捷方式">
      <ComponentRef Id="CxDesktopShortcut" />
    </Feature>

<?if $(var.WithUi) = 1 ?>
    <ui:WixUI Id="WixUI_FeatureTree" />
<?endif?>

    <ComponentGroup Id="CxBinaries" Directory="INSTALLFOLDER">
      <Component Id="CxExe" Guid="5496894D-B94F-47F0-AFF3-4EE38F700A75">
        <File Id="CxExeFile" Source="$(var.BinDir)\cx.exe" KeyPath="yes" />
      </Component>
      <!-- 自建服务端一起装：它不依赖剪贴板与图形会话，装在桌面机上完全合理
           （同一台机器既当服务端又当客户端是官方支持的用法），
           单独发行只会让人多一步下载。 -->
      <Component Id="CxServerExe" Guid="7F3C2A64-1B95-4E28-9D71-6C0E5A8B42D3">
        <File Id="CxServerExeFile" Source="$(var.BinDir)\cx-server.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- 用户级 PATH（HKCU\Environment），卸载时由 MSI 自动还原 -->
    <Component Id="CxUserPath" Directory="INSTALLFOLDER"
               Guid="028361B8-F828-4009-AE3B-DF0BF1048EE3">
      <Environment Id="CxUserPathEnv"
                   Name="PATH"
                   Value="[INSTALLFOLDER]"
                   Part="last"
                   Action="set"
                   Permanent="no"
                   System="no" />
      <RegistryValue Root="HKCU" Key="Software\ClipboardX" Name="PathAdded"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- 登录自启：HKCU\...\Run -->
    <Component Id="CxAutostart" Directory="INSTALLFOLDER"
               Guid="1CBBC060-0729-47C8-AC90-111EF80EB17D">
      <RegistryValue Root="HKCU"
                     Key="Software\Microsoft\Windows\CurrentVersion\Run"
                     Name="ClipboardX"
                     Type="string"
                     Value="&quot;[INSTALLFOLDER]cx.exe&quot; start --silent"
                     KeyPath="yes" />
    </Component>

    <Component Id="CxStartMenu" Directory="CxMenuFolder"
               Guid="BB086E78-FF5B-4991-9923-6C6343135D85">
      <Shortcut Id="CxTuiShortcut"
                Name="ClipboardX TUI"
                Description="打开 ClipboardX 终端界面"
                Target="[INSTALLFOLDER]cx.exe"
                Arguments="tui"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="CxRemoveMenuFolder" Directory="CxMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\ClipboardX" Name="StartMenu"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="CxDesktopShortcut" Guid="C1D28912-D240-4FE7-B349-15BE2C32CBA7">
        <Shortcut Id="CxDesktopTuiShortcut"
                  Name="ClipboardX"
                  Description="打开 ClipboardX 终端界面"
                  Target="[INSTALLFOLDER]cx.exe"
                  Arguments="tui"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\ClipboardX" Name="DesktopShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- 仅在 REMOVEUSERDATA=1 时清除配置/密钥/历史 -->
    <CustomAction Id="CxRemoveUserData"
                  Directory="INSTALLFOLDER"
                  ExeCommand="cmd.exe /c rmdir /s /q &quot;[CxUserDataFolder]&quot;"
                  Execute="immediate"
                  Return="ignore" />

    <!-- ── 覆盖安装 / 卸载：先让正在运行的 cx 退出 ──────────────────────────
         为什么需要：cx.exe 就是守护进程（也是 TUI 的宿主）。它一直在后台运行，
         因此升级时 %LOCALAPPDATA%\Programs\ClipboardX\cx.exe 正被占用，MSI 会弹出
         「文件正在使用 / FilesInUse」对话框等用户点，静默安装则直接失败（1603）。
         macOS 的 pkg 没这个问题（它换的是 inode），Windows 必须显式处理。

         先礼后兵，两个动作都排在 InstallValidate 之前——文件占用检查就发生在
         InstallValidate，晚了对话框已经弹出来了：
         1) CxStopRunning：`cx stop` 走控制套接字，守护进程正常收尾（写出待同步
            队列、关掉套接字），不会丢剪贴板条目；
         2) CxKillRunning：兜底。守护进程是 CREATE_NO_WINDOW 创建的，没有窗口可发
            WM_CLOSE；用户开着 cx tui、或守护进程不响应时只有强制结束才不阻塞安装。
            注意 `cx tui` 也是 cx.exe，所以它会一起被关掉（必要时请重新打开）。 -->
    <CustomAction Id="CxStopRunning"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]cx.exe&quot; stop"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />
    <CustomAction Id="CxKillRunning"
                  Directory="INSTALLFOLDER"
                  ExeCommand="cmd.exe /c taskkill /f /t /im cx.exe &gt;nul 2&gt;nul &amp; taskkill /f /t /im cx-server.exe &gt;nul 2&gt;nul &amp; exit 0"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />

    <!-- 装完之后把守护进程放回后台：否则升级一次 = 同步悄悄停到下次登录。
         只在上面的动作真的执行过（已安装 / 升级）且不是卸载时才做。
         asyncNoWait：不等它退出。守护进程本身是分离进程（不继承句柄），
         但没必要让 MSI 卡在这里多等一次启动。 -->
    <CustomAction Id="CxRestartDaemon"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]cx.exe&quot; start --silent"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="CxStopRunning" Before="CxKillRunning"
              Condition="Installed OR WIX_UPGRADE_DETECTED" />
      <Custom Action="CxKillRunning" Before="InstallValidate"
              Condition="Installed OR WIX_UPGRADE_DETECTED" />
      <Custom Action="CxRestartDaemon" After="InstallFinalize"
              Condition="(Installed OR WIX_UPGRADE_DETECTED) AND NOT REMOVE=&quot;ALL&quot;" />
      <Custom Action="CxRemoveUserData" After="InstallInitialize"
              Condition="REMOVE=&quot;ALL&quot; AND REMOVEUSERDATA=&quot;1&quot;" />
    </InstallExecuteSequence>

    <!-- 交互式安装还要在 UI 序列里先做一遍：文件占用检查发生在 UI 序列的
         InstallValidate 上，是它弹出 FilesInUse 对话框，那正是"安装卡住不动"的现场。
         UI 序列里的标准动作是按需生成的，没有可引用的 InstallValidate 名字，
         因此直接给序号：690/695 落在 CostFinalize(400) 与 InstallValidate(700) 之间。 -->
    <InstallUISequence>
      <Custom Action="CxStopRunning" Sequence="690"
              Condition="Installed OR WIX_UPGRADE_DETECTED" />
      <Custom Action="CxKillRunning" Sequence="695"
              Condition="Installed OR WIX_UPGRADE_DETECTED" />
    </InstallUISequence>

  </Package>
</Wix>
