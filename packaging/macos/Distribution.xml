<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>ClipboardX</title>
    <organization>com.clipboardx</organization>
    <domains enable_localSystem="true" enable_currentUserHome="false" />
    <options customize="allow" require-scripts="false" rootVolumeOnly="true" hostArchitectures="arm64,x86_64" />

    <welcome file="welcome.html" mime-type="text/html" />
    <conclusion file="conclusion.html" mime-type="text/html" />

    <choices-outline>
        <line choice="default">
            <line choice="com.clipboardx.cli" />
            <line choice="com.clipboardx.agent" />
        </line>
    </choices-outline>

    <choice id="default" />

    <choice id="com.clipboardx.cli" visible="true"
            title="命令行工具 cx"
            description="安装到 /usr/local/bin/cx，之后可在终端运行 cx status、cx tui 等命令。"
            selected="true" />

    <choice id="com.clipboardx.agent" visible="true"
            title="登录后自动后台同步"
            description="安装 LaunchAgent（/Library/LaunchAgents/com.clipboardx.agent.plist），登录后在用户会话中启动同步守护进程。剪贴板只能在用户会话内访问，因此不使用 LaunchDaemon。"
            selected="true" />

    <pkg-ref id="com.clipboardx.cli" />
    <pkg-ref id="com.clipboardx.agent" />
</installer-gui-script>
